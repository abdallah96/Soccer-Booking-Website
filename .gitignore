# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
*.test.js.snap

# next.js
/.next/
/out/
/.swc/

# production
/build
/dist

# misc
.DS_Store
*.pem
Thumbs.db
*.swp
*.swo
*~

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# Environment variables - CRITICAL: Never commit these!
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
*.env
*.env.json
http-client.env.json
# Local script credentials (e.g. for create-super-admin)
scripts/.env
scripts/.env.local

# IDE and Editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.code-workspace
.project
.classpath
.settings/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Cache and temporary files
.cache/
.turbo/
.parcel-cache/
.eslintcache
.stylelintcache
*.log

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini

# Personal/training files (if any)
TRAINING_GUIDE.md
PHASE_1_2_COMPLETE.md

# Database dumps and backups
*.sql.backup
*.dump
*.bak

# Secrets and keys
*.key
*.pem
*.p12
*.pfx
secrets/
.secrets/

# Local configuration overrides
config.local.*
*.local.*